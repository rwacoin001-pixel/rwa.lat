{
  "name": "rwalat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3030",
    "build": "next build",
    "build:production": "node scripts/build-production.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev:all": "bash dev-all.sh",
    "dev:all:stop": "bash dev-all.sh stop",
    "verify:demo": "node scripts/verify-demo.mjs",
    "verify:account": "node scripts/verify-account.mjs",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "node scripts/require-merged-release.mjs && node scripts/build-production.mjs frontend && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "api:types": "openapi-typescript http://127.0.0.1:4000/v1/docs-json -o lib/api/schema.d.ts",
    "api:count": "node -e \"fetch('http://127.0.0.1:4000/v1/docs-json').then(r=>r.json()).then(s=>{const p=s.paths;let t=0,c=0;for(const k of Object.keys(p))for(const m of Object.keys(p[k]))if(['get','post','put','patch','delete'].includes(m))t++;console.log('method-level endpoints:',t)})\""
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@formkit/auto-animate": "^0.10.0",
    "@number-flow/react": "^0.6.2",
    "@paper-design/shaders-react": "^0.0.81",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@rwa-lat/api-client": "workspace:*",
    "@tremor/react": "^3.18.7",
    "@vercel/analytics": "1.6.1",
    "@web3icons/react": "^4.1.22",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "country-flag-icons": "^1.6.20",
    "framer-motion": "^12.42.2",
    "geist": "^1.7.2",
    "gsap": "^3.15.0",
    "lightweight-charts": "^5.2.1",
    "lucide-react": "^1.16.0",
    "mammoth": "^1.13.0",
    "motion": "^12.43.0",
    "next": "16.2.11",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "qrcode.react": "^4.2.0",
    "react": "^19",
    "react-dom": "^19",
    "recharts": "3.8.0",
    "shadcn": "^4.8.0",
    "simple-icons": "^16.32.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tesseract.js": "^7.0.0",
    "three": "^0.185.1",
    "tw-animate-css": "^1.4.0",
    "wavesurfer.js": "8.0.1"
  },
