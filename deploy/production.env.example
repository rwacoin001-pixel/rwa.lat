# Copy these names into the deployment platform or Secret Manager. Never
# commit a populated production.env file.
APP_ENV=production
NODE_ENV=production

# PostgreSQL 16+; both URLs must use TLS and a database ending in _production.
PRODUCTION_DATABASE_URL=
ADMIN_DATABASE_URL=
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
API_HOST_PORT=4000
ADMIN_HOST_PORT=4100

# Public origins. The canonical frontend domain is a-reit.com.
PUBLIC_API_URL=https://api.a-reit.com
PUBLIC_APP_URL=https://a-reit.com
PUBLIC_ADMIN_API_URL=https://admin-api.a-reit.com
CORS_ORIGINS=https://a-reit.com,https://www.a-reit.com
ADMIN_CORS_ORIGINS=https://admin.a-reit.com
# Set this only after counting the real CDN/load-balancer hops.
TRUST_PROXY_HOPS=1
PASSKEY_RP_ID=a-reit.com
PASSKEY_RP_NAME=A-REIT
PASSKEY_ORIGIN=https://a-reit.com

# Inject independent values from Secret Manager. Do not reuse any key.
IDENTITY_HMAC_KEY=
# Choose either the single-key variables or the versioned rotation variables.
IDENTITY_ENC_KEY=
IDENTITY_ENC_KEYS_JSON=
IDENTITY_ACTIVE_KEY_VERSION=
METRICS_BEARER_TOKEN=
ADMIN_MFA_ENCRYPTION_KEY=
ADMIN_MFA_KEYS_JSON=
ADMIN_MFA_ACTIVE_KEY_VERSION=
ADMIN_MFA_REQUIRED=true
WALLET_WEBHOOK_SECRET=
# Stable server-only random secret, at least 32 bytes. Provision before enabling the new withdrawal API.
# Keep separately from the database/backup; changing it invalidates existing transaction PIN hashes.
TRANSACTION_PIN_PEPPER=

AUTH_ADAPTER=production
# Resend uses HTTPS and works on platforms that block outbound SMTP ports.
EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@a-reit.com
EMAIL_FROM_NAME=A-REIT
RESEND_API_KEY=
RESEND_HTTP_TIMEOUT_MS=10000
# SMTP remains supported for hosts that allow outbound mail connections.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_AUTH_MODE=plain
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=10000
SMTP_SOCKET_TIMEOUT_MS=20000

# Google can be enabled after the production client secret is stored. X stays
# disabled while the X account/application is suspended or unapproved.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://a-reit.com/auth/callback/google
GITHUB_OAUTH_ENABLED=false
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://a-reit.com/auth/callback/github
X_OAUTH_ENABLED=false
X_OAUTH_CLIENT_ID=
X_OAUTH_CLIENT_SECRET=
# X stays disabled until its new-domain callback is registered.
X_OAUTH_REDIRECT_URI=https://a-reit.com/auth/callback/x
OAUTH_HTTP_TIMEOUT_MS=10000

# Safe first production deployment: real auth/runtime, all money movement off.
PRODUCTION_FINANCIAL_FEATURES_ENABLED=false
WALLET_EXECUTION_ENABLED=false
WALLET_EXECUTION_WORKER_ENABLED=false
POLYMARKET_TRADING_ENABLED=false
DEMO_OPERATIONS_ENABLED=false
DEMO_WALLET_CREDIT_ENABLED=false

# KYC runs through Didit as hosted verification sessions. Fill in the values
# from the Didit business console before deploying (Free KYC workflow at launch).
KYC_PROVIDER=didit
DIDIT_API_BASE_URL=https://verification.didit.me
DIDIT_API_KEY=
DIDIT_WORKFLOW_ID=
DIDIT_WEBHOOK_SECRET=
DIDIT_CALLBACK_URL=https://a-reit.com/profile/kyc?status=complete
DIDIT_API_TIMEOUT_MS=10000
DIDIT_API_MAX_RETRIES=2
DIDIT_API_RETRY_BASE_DELAY_MS=500
# Configure the Didit destination itself as:
# https://api.a-reit.com/v1/compliance/kyc/webhooks/didit

# SANCTIONS_PROVIDER=disabled 为操作方显式关闭筛查（2026-09-18 决策，一律放行并如实记录）。
# 托管 = 手动模式（2026-09-18）：操作员地址池 + 自持热钱包本地签名，无 MPC/托管商。
# 资金开关默认全关；启用顺序（先充后提）：
#   1) 配置 TRON_*（热钱包私钥）并部署（WALLET_CUSTODY_ADAPTER=manual）
#   2) 管理台生成入金地址池（/wallets 页面）
#   3) 开启 WALLET_CHAIN_WATCHER_ENABLED=true 并部署（链上监听开始）
#   4) PRODUCTION_FINANCIAL_FEATURES_ENABLED=true + WALLET_EXECUTION_ENABLED=true
#      + WALLET_EXECUTION_WORKER_ENABLED=true + 限额/地区显式配置
#   5) 管理台「资金开关」走双管理员 resume 流程后，提现才可自动发币
SANCTIONS_PROVIDER=disabled
WALLET_CUSTODY_ADAPTER=manual
TRON_API_BASE_URL=https://api.trongrid.io
# 全节点接口（/wallet/*：最新区块、交易结果、构建与广播提现）。可填 GetBlock 完整端点，
# 如 https://go.getblock.io/<access-token>（token 在路径里，属于密钥，只写在服务器 env，不进 Git/日志）。
# 留空则回落到 TRON_API_BASE_URL。
TRON_NODE_URL=
# TronGrid 索引查询（/v1/accounts/.../transactions/trc20，按地址查 USDT 转入）。GetBlock 不提供此接口。
# 留空则回落到 TRON_API_BASE_URL。
TRON_INDEX_URL=
# TronGrid API Key：只会发给 *.trongrid.io，不会发给 GetBlock 等其他节点。
TRON_API_KEY=
# 同一服务商两次请求的最小间隔（毫秒）。默认：无 Key 的 TronGrid 1500，其余 100。
TRON_NODE_MIN_INTERVAL_MS=
TRON_INDEX_MIN_INTERVAL_MS=
TRON_API_TIMEOUT_MS=12000
TRON_API_MAX_RETRIES=2
TRON_USDT_CONTRACT=TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t
TRON_HOT_WALLET_PRIVATE_KEY=
TRON_WITHDRAWAL_FEE_LIMIT_SUN=100000000
TRON_BROADCAST_RESCUE_WINDOW_MINUTES=120
WALLET_CHAIN_WATCHER_ENABLED=false
# 按需监听充值（手动托管）：用户打开充值页或点「我已转账」后进入监听窗口，期间每 WATCH_SCAN_SECONDS 扫一次；
# 之后逐步放慢（5 分钟 / 15 分钟 / 1 小时，24 小时内），再之后每 IDLE_SCAN_MINUTES 兜底扫一次。
# 监听进程每 TICK_MS 醒来一次，只对到期地址和在途确认调用 TRON。WALLET_CHAIN_WATCHER_POLL_MS 已不再使用。
WALLET_CHAIN_WATCHER_TICK_MS=15000
WALLET_DEPOSIT_WATCH_MINUTES=60
WALLET_DEPOSIT_WATCH_SCAN_SECONDS=30
WALLET_DEPOSIT_IDLE_SCAN_MINUTES=360
WALLET_CHAIN_WATCHER_POLL_MS=120000
WALLET_CHAIN_WATCHER_DEPOSIT_BATCH=8
WALLET_CHAIN_WATCHER_CONFIRMATION_BATCH=25
ALLOWED_REGIONS=
WITHDRAWAL_ADDRESS_COOLDOWN_SECONDS=86400
WITHDRAWAL_NEW_DEVICE_COOLDOWN_SECONDS=86400
WITHDRAWAL_PER_TRANSACTION_LIMIT_ATOMIC=
WITHDRAWAL_DAILY_LIMIT_ATOMIC=
WITHDRAWAL_ADMIN_APPROVALS_REQUIRED=1
WITHDRAWAL_EXECUTION_LEASE_SECONDS=120
WALLET_EXECUTION_QUEUE_LEASE_SECONDS=300
WALLET_EXECUTION_WORKER_POLL_MS=5000
FINANCIAL_RELEASE_CHANGE_ID=

# Object storage remains locked until KMS and malware scanning are rehearsed.
OBJECT_STORAGE_ENABLED=false
S3_REGION=
S3_ENDPOINT=
S3_AUTH_MODE=workload
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_KMS_KEY_ID=
S3_FORCE_PATH_STYLE=false
S3_BUCKET_MAP_JSON={"rwa-kyc":"replace-prod-kyc","rwa-assets":"replace-prod-assets","rwa-attachments":"replace-prod-attachments"}
OBJECT_STORAGE_SCAN_PROVIDER=
OBJECT_STORAGE_SCAN_CALLBACK_SECRET=

# Each partner must receive a distinct 32+ character secret.
PARTNER_CALLBACK_SECRETS_JSON=

# Optional telemetry exports.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=rwa-lat-core
LOG_LEVEL=info
