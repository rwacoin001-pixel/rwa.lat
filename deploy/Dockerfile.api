# syntax=docker/dockerfile:1.7
FROM node:22-bookworm-slim AS build
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    NODE_OPTIONS=--max-old-space-size=1024
RUN corepack enable
WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY apps/api/package.json apps/api/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY apps/admin-frontend/package.json apps/admin-frontend/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/contracts packages/contracts
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter @rwa-lat/api... --filter '!rwalat' --prefer-offline --ignore-scripts --network-concurrency=8

COPY apps/api apps/api
RUN cd apps/api && node --max-old-space-size=1024 node_modules/@nestjs/cli/bin/nest.js build

FROM node:22-bookworm-slim AS runtime
ARG SOURCE_REVISION=unrecorded
LABEL org.opencontainers.image.revision=$SOURCE_REVISION \
    org.opencontainers.image.source="https://github.com/rwacoin001-pixel/rwa.lat"
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    NODE_ENV=production \
    APP_ENV=production \
    PORT=4000
RUN corepack enable
RUN apt-get update && apt-get install -y --no-install-recommends chromium chromium-sandbox fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
ENV DOCUMENT_PDF_EXECUTABLE_PATH=/usr/bin/chromium \
    DOCUMENT_PDF_DISABLE_SANDBOX=false
WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches
COPY apps/api/package.json apps/api/package.json
COPY apps/admin/package.json apps/admin/package.json
COPY apps/admin-frontend/package.json apps/admin-frontend/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/contracts packages/contracts
RUN --mount=type=cache,id=pnpm-prod,target=/pnpm/store \
    pnpm install --frozen-lockfile --prod --filter @rwa-lat/api... --filter '!rwalat' --prefer-offline --ignore-scripts --network-concurrency=8

COPY --from=build --chown=node:node /workspace/apps/api/dist apps/api/dist
USER node
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/v1/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["sh", "-c", "cd apps/api && node_modules/.bin/typeorm migration:run -d dist/database/data-source.js && cd /workspace && exec node apps/api/dist/main.js"]
