# Server-only configuration. Do not expose these values with NEXT_PUBLIC_ prefixes.
POLYMARKET_RELAYER_API_KEY=
POLYMARKET_RELAYER_API_KEY_ADDRESS=
POLYMARKET_BUILDER_ADDRESS=
POLYMARKET_BUILDER_CODE=
POLYMARKET_READ_ENABLED=true
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_TRADING_ENABLED=false

# API-only wallet controls. Real execution remains off until a live custody adapter is installed.
WALLET_EXECUTION_ENABLED=false
WALLET_WEBHOOK_SECRET=

# H5 → Core API base URL (single source of truth for all pages)
NEXT_PUBLIC_API_URL=http://localhost:4000
# Identity verification (KYC) prompts are hidden by default. Set to true together with the API's KYC_REQUIRED_FOR_INVESTMENT=true.
NEXT_PUBLIC_KYC_REQUIRED=false
CATALOG_AUTO_QUOTES_ENABLED=false
DOCUMENT_PDF_SERVICE_URL=
DOCUMENT_PDF_SERVICE_SECRET=

# Optional public login-page licensing disclosure. Leave all fields blank to hide it.
# Only populate with verified details; the configured values are visible to site visitors.
NEXT_PUBLIC_AUTH_LICENSE_ENTITY=
NEXT_PUBLIC_AUTH_LICENSE_REGULATOR=
NEXT_PUBLIC_AUTH_LICENSE_TYPE=
NEXT_PUBLIC_AUTH_LICENSE_NUMBER=
NEXT_PUBLIC_AUTH_LICENSE_URL=
