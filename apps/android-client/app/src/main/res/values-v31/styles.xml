<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Android 12+: the system splash uses the page colour and the app icon, and stays until the page is ready. -->
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#B79757</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@drawable/launch_window</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:isLightTheme" tools:targetApi="29">@bool/light_theme</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
    </style>
    <!-- Android 13+ shows these on the next launch once the user has picked a theme (SplashScreen.setSplashScreenTheme),
         so a light-theme user on a dark phone no longer sees a black splash turn white. -->
    <style name="AppTheme.Light">
        <item name="android:windowBackground">@drawable/launch_window_light</item>
        <item name="android:isLightTheme" tools:targetApi="29">true</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg_light</item>
    </style>
    <style name="AppTheme.Dark">
        <item name="android:windowBackground">@drawable/launch_window_dark</item>
        <item name="android:isLightTheme" tools:targetApi="29">false</item>
        <item name="android:windowSplashScreenBackground">@color/launch_bg_dark</item>
    </style>
</resources>
