# Server-only BFF upstream. Do not use NEXT_PUBLIC_* for admin credentials,
# session secrets, or API keys.
ADMIN_API_URL=http://localhost:4100/v1

# Required in production (no localhost fallback outside dev).
# ADMIN_API_URL above.
# Optional: extra origins allowed to send write requests (comma-separated).
ADMIN_ALLOWED_ORIGINS=
# Optional, build time: browser-visible object-storage origins for presigned uploads (CSP connect-src).
ADMIN_CSP_CONNECT_SRC=
