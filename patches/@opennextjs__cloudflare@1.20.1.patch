+// Next 16 loads the middleware manifest with a bare `require(this.middlewareManifestPath)`
+// which esbuild cannot resolve statically and therefore becomes an unsupported dynamic
+// require at runtime (workerd). Route it through the patched `loadManifest` instead so it
+// resolves from the inlined manifests (like every other manifest already does).
+export const middlewareManifestRule = `
+rule:
+  pattern:
+    selector: method_definition
+    context: "class { getMiddlewareManifest($$$PARAMS) { $$$_ } }"
+fix: |-
+  getMiddlewareManifest($$$PARAMS) {
+    return this.minimalMode ? null : (0, _loadmanifestexternal.loadManifest)(this.middlewareManifestPath);
+  }
